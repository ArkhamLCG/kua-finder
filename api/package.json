{
  "name": "kua-finder-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "parse:page": "tsx src/scripts/parse-page.ts",
    "update:products": "tsx src/scripts/update-products.ts",
    "parse:product": "tsx src/scripts/parse-product.ts",
    "parse:region": "tsx src/scripts/parse-region.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2"
  }
}
